{% form
   category="taxes"
   class="f1040sA"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-schedule-a-form-1040"
   maxInstances=1 %}
# Schedule A (Form 1040)

{% subtitle %}Itemized Deductions{% /subtitle %}

{% section %}
## Medical and Dental Expenses

{% lines %}
- {% line index="1" %}
  - {% instructions %}Medical and dental expenses (see instructions){% /instructions %}
  - {% box identifier="1" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Enter amount from Form 1040 or 1040-SR, line 11b{% /instructions %}
  - {% box identifier="2" %}{% value type="box_reference" form="f1040" box="11b" required=true /%}{% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Multiply line 2 by 7.5% (0.075){% /instructions %}
  - {% box identifier="3" %}
    {% value type="product" %}
    - {% value type="box_reference" box="2" /%}
    - {% value type="number_constant" value=0.075 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Subtract line 3 from line 1. If line 3 is more than line 1, enter -0-{% /instructions %}
  - {% box identifier="4" %}
    {% value type="non_negative_clamp" %}
    - {% value type="difference" %}
      - {% value slot="minuend" type="box_reference" box="1" /%}
      - {% value slot="subtrahend" type="box_reference" box="3" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Taxes You Paid

{% lines %}
- {% line index="5" %}
  - {% instructions %}State and local taxes (SALT):{% /instructions %}
  - {% box identifier="5" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="5a" %}
  - {% instructions %}State and local income taxes or general sales taxes. You may include either income taxes or general sales taxes on line 5a, but not both{% /instructions %}
  - {% box identifier="5a" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="5b" %}
  - {% instructions %}State and local real estate taxes (see instructions){% /instructions %}
  - {% box identifier="5b" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="5c" %}
  - {% instructions %}State and local personal property taxes{% /instructions %}
  - {% box identifier="5c" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="5d" %}
  - {% instructions %}Add lines 5a through 5c{% /instructions %}
  - {% box identifier="5d" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="5a" /%}
    - {% value type="box_reference" box="5b" /%}
    - {% value type="box_reference" box="5c" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="5e" %}
  - {% instructions %}Enter the smaller of line 5d or $40,000 ($20,000 if married filing separately). If Form 1040 or 1040-SR, line 11b is more than $500,000 ($250,000 if married filing separately), or if you completed Form 2555, Form 4563, or excluded income from Puerto Rico, see instructions{% /instructions %}
  - {% box identifier="5e" %}
    {% value type="minimum" %}
    - {% value type="box_reference" box="5d" /%}
    - {% value type="filing_status_map" %}
      - {% value
           type="number_constant"
           value=20000
           filingStatusKey="married_filing_separately" /%}
      - {% value slot="default" type="number_constant" value=40000 /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Other taxes. List type and amount:{% /instructions %}
  - {% box identifier="6" %}{% value type="list_amounts_input" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Add lines 5e and 6{% /instructions %}
  - {% box identifier="7" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="5e" /%}
    - {% value type="box_reference" box="6" /%}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Interest You Paid

{% lines %}
- {% line index="8" %}
  - {% instructions %}Home mortgage interest and points. If you didn't use all of your home mortgage loan(s) to buy, build, or improve your home, see instructions{% /instructions %}
  - {% box identifier="8" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="8a" %}
  - {% instructions %}Home mortgage interest and points reported to you on Form 1098. See instructions if limited{% /instructions %}
  - {% box identifier="8a" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="8b" %}
  - {% instructions %}Home mortgage interest not reported to you on Form 1098. See instructions if limited. If paid to the person from whom you bought the home, see instructions{% /instructions %}
  - {% box identifier="8b" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="8c" %}
  - {% instructions %}Points not reported to you on Form 1098. See instructions for special rules{% /instructions %}
  - {% box identifier="8c" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="8d" %}
  - {% instructions %}Reserved for future use{% /instructions %}
  - {% box identifier="8d" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="8e" %}
  - {% instructions %}Add lines 8a through 8c{% /instructions %}
  - {% box identifier="8e" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="8a" /%}
    - {% value type="box_reference" box="8b" /%}
    - {% value type="box_reference" box="8c" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="9" %}
  - {% instructions %}Investment interest. Attach Form 4952 if required. See instructions{% /instructions %}
  - {% box identifier="9" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="10" %}
  - {% instructions %}Add lines 8e and 9{% /instructions %}
  - {% box identifier="10" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="8e" /%}
    - {% value type="box_reference" box="9" /%}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Gifts to Charity

{% lines %}
- {% line index="11" %}
  - {% instructions %}Gifts by cash or check. If you made any gift of $250 or more, see instructions{% /instructions %}
  - {% box identifier="11" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="12" %}
  - {% instructions %}Other than by cash or check. If you made any gift of $250 or more, see instructions. You must attach Form 8283 if over $500{% /instructions %}
  - {% box identifier="12" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="13" %}
  - {% instructions %}Carryover from prior year{% /instructions %}
  - {% box identifier="13" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="14" %}
  - {% instructions %}Add lines 11 through 13{% /instructions %}
  - {% box identifier="14" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="11" /%}
    - {% value type="box_reference" box="12" /%}
    - {% value type="box_reference" box="13" /%}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Casualty and Theft Losses

{% lines %}
- {% line index="15" %}
  - {% instructions %}Casualty and theft loss(es) from a federally declared disaster (other than net qualified disaster losses). Attach Form 4684 and enter the amount from line 18 of that form. See instructions{% /instructions %}
  - {% box identifier="15" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Other Itemized Deductions

{% lines %}
- {% line index="16" %}
  - {% instructions %}Other—from list in instructions. List type and amount:{% /instructions %}
  - {% box identifier="16" %}{% value type="list_amounts_input" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Total Itemized Deductions

{% lines %}
- {% line index="17" %}
  - {% instructions %}Add the amounts in the far right column for lines 4 through 16. Also, enter this amount on Form 1040 or 1040-SR, line 12e{% /instructions %}
  - {% box identifier="17" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="4" /%}
    - {% value type="box_reference" box="7" /%}
    - {% value type="box_reference" box="10" /%}
    - {% value type="box_reference" box="14" /%}
    - {% value type="box_reference" box="15" /%}
    - {% value type="box_reference" box="16" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="18" %}
  - {% instructions %}If you elect to itemize deductions even though they are less than your standard deduction, check this box{% /instructions %}
  - {% box identifier="18" %}{% value type="checkbox_input" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
