{% form
   category="taxes"
   class="f8995"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-form-8995"
   maxInstances=1 %}
# Form 8995

{% subtitle %}Qualified Business Income Deduction Simplified Computation{% /subtitle %}

{% section %}
{% columns %}
- {% column index="(a)" %}
  {% instructions %}Trade, business, or aggregation name{% /instructions %}
  {% /column %}
- {% column index="(b)" %}
  {% instructions %}Taxpayer identification number{% /instructions %}
  {% /column %}
- {% column index="(c)" %}
  {% instructions %}Qualified business income or (loss){% /instructions %}
  {% /column %}
{% /columns %}

{% lines %}
- {% line index="1i" %}
  - {% box identifier="1i(a)" column="(a)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1i(b)" column="(b)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1i(c)" column="(c)" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1ii" %}
  - {% box identifier="1ii(a)" column="(a)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1ii(b)" column="(b)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1ii(c)" column="(c)" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1iii" %}
  - {% box identifier="1iii(a)" column="(a)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1iii(b)" column="(b)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1iii(c)" column="(c)" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1iv" %}
  - {% box identifier="1iv(a)" column="(a)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1iv(b)" column="(b)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1iv(c)" column="(c)" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1v" %}
  - {% box identifier="1v(a)" column="(a)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1v(b)" column="(b)" %}{% value type="unused" /%}{% /box %}
  - {% box identifier="1v(c)" column="(c)" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
{% lines %}
- {% line index="2" %}
  - {% instructions %}Total qualified business income or (loss). Combine lines 1i through 1v, column (c){% /instructions %}
  - {% box identifier="2" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="1i(c)" /%}
    - {% value type="box_reference" box="1ii(c)" /%}
    - {% value type="box_reference" box="1iii(c)" /%}
    - {% value type="box_reference" box="1iv(c)" /%}
    - {% value type="box_reference" box="1v(c)" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Qualified business net (loss) carryforward from the prior year{% /instructions %}
  - {% box identifier="3" %}{% value type="number_input" coerceSign="negative" /%}{% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Total qualified business income. Combine lines 2 and 3. If zero or less, enter -0-{% /instructions %}
  - {% box identifier="4" %}
    {% value type="non_negative_clamp" %}
    - {% value type="sum" %}
      - {% value type="box_reference" box="2" /%}
      - {% value type="box_reference" box="3" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="5" %}
  - {% instructions %}Qualified business income component. Multiply line 4 by 20% (0.20){% /instructions %}
  - {% box identifier="5" %}
    {% value type="product" %}
    - {% value type="box_reference" box="4" /%}
    - {% value type="number_constant" value=0.2 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Qualified REIT dividends and publicly traded partnership (PTP) income or (loss) (see instructions){% /instructions %}
  - {% box identifier="6" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Qualified REIT dividends and qualified PTP (loss) carryforward from the prior year{% /instructions %}
  - {% box identifier="7" %}{% value type="number_input" coerceSign="negative" /%}{% /box %}
  {% /line %}
- {% line index="8" %}
  - {% instructions %}Total qualified REIT dividends and PTP income. Combine lines 6 and 7. If zero or less, enter -0-{% /instructions %}
  - {% box identifier="8" %}
    {% value type="non_negative_clamp" %}
    - {% value type="sum" %}
      - {% value type="box_reference" box="6" /%}
      - {% value type="box_reference" box="7" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="9" %}
  - {% instructions %}REIT and PTP component. Multiply line 8 by 20% (0.20){% /instructions %}
  - {% box identifier="9" %}
    {% value type="product" %}
    - {% value type="box_reference" box="8" /%}
    - {% value type="number_constant" value=0.2 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="10" %}
  - {% instructions %}Qualified business income deduction before the income limitation. Add lines 5 and 9{% /instructions %}
  - {% box identifier="10" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="5" /%}
    - {% value type="box_reference" box="9" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="11" %}
  - {% instructions %}Taxable income before qualified business income deduction (see instructions){% /instructions %}
  - {% box identifier="11" %}
    {% value type="difference" %}
    - {% value
         slot="minuend"
         type="box_reference"
         form="f1040"
         box="11a"
         required=true /%}
    - {% value slot="subtrahend" type="sum" %}
      - {% value type="box_reference" form="f1040" box="12e" required=true /%}
      - {% value type="box_reference" form="f1040" box="13b" required=true /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="12" %}
  - {% instructions %}Enter your net capital gain, if any, increased by any qualified dividends (see instructions){% /instructions %}
  - {% box identifier="12" %}
    {% value type="sum" %}
    - {% value type="box_reference" form="f1040" box="3a" required=true /%}
    - {% value type="conditional" %}
      - {% value slot="condition" type="form_instance_count" form="f1040sD" /%}
      - {% value slot="trueValue" type="non_negative_clamp" %}
        - {% value type="minimum" %}
          - {% value type="box_reference" form="f1040sD" box="15" /%}
          - {% value type="box_reference" form="f1040sD" box="16" /%}
          {% /value %}
        {% /value %}
      - {% value
           slot="falseValue"
           type="box_reference"
           form="f1040"
           box="7a"
           required=true /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="13" %}
  - {% instructions %}Subtract line 12 from line 11. If zero or less, enter -0-{% /instructions %}
  - {% box identifier="13" %}
    {% value type="non_negative_clamp" %}
    - {% value type="difference" %}
      - {% value slot="minuend" type="box_reference" box="11" /%}
      - {% value slot="subtrahend" type="box_reference" box="12" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="14" %}
  - {% instructions %}Income limitation. Multiply line 13 by 20% (0.20){% /instructions %}
  - {% box identifier="14" %}
    {% value type="product" %}
    - {% value type="box_reference" box="13" /%}
    - {% value type="number_constant" value=0.2 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="15" %}
  - {% instructions %}Qualified business income deduction. Enter the smaller of line 10 or line 14. Also enter this amount on the applicable line of your return (see instructions){% /instructions %}
  - {% box identifier="15" %}
    {% value type="minimum" %}
    - {% value type="box_reference" box="10" /%}
    - {% value type="box_reference" box="14" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="16" %}
  - {% instructions %}Total qualified business (loss) carryforward. Combine lines 2 and 3. If greater than zero, enter -0-{% /instructions %}
  - {% box identifier="16" %}
    {% value type="non_positive_clamp" %}
    - {% value type="sum" %}
      - {% value type="box_reference" box="2" /%}
      - {% value type="box_reference" box="3" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="17" %}
  - {% instructions %}Total qualified REIT dividends and PTP (loss) carryforward. Combine lines 6 and 7. If greater than zero, enter -0-{% /instructions %}
  - {% box identifier="17" %}
    {% value type="non_positive_clamp" %}
    - {% value type="sum" %}
      - {% value type="box_reference" box="6" /%}
      - {% value type="box_reference" box="7" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
