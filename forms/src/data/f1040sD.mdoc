    - {% value type="box_reference" box="2(g)" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Totals for all transactions reported on Form(s) 8949 with Box C or Box I checked{% /instructions %}
  - {% box identifier="3(d)" column="(d)" %}{% value type="number_input" /%}{% /box %}
  - {% box identifier="3(e)" column="(e)" %}{% value type="number_input" /%}{% /box %}
