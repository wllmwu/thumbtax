      - {% value slot="subtrahend" type="box_reference" box="1b(e)" /%}
      {% /value %}
    - {% value type="box_reference" box="1b(g)" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Totals for all transactions reported on Form(s) 8949 with Box B or Box H checked{% /instructions %}
  - {% box identifier="2(d)" column="(d)" %}{% value type="number_input" /%}{% /box %}
