      - {% value slot="subtrahend" type="box_reference" box="1a(e)" /%}
      {% /value %}
    - {% value type="box_reference" box="1a(g)" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="1b" %}
