{% form
   category="income"
   class="helper_withholding_additionalmedicare"
   irsPageUrl="" %}
# My Additional Medicare withholding

{% subtitle %}
Helper form: Additional Medicare tax withholding
{% /subtitle %}

{% instructions %}
Thumbtax uses this "helper" form to model a part of your income tax withholding.
This isn't a real tax form.
You can modify these values directly or use the wizard again to replace them.
{% /instructions %}

{% section %}
{% lines %}
- {% line index="1" %}
  - {% instructions %}Gross amount{% /instructions %}
  - {% box identifier="1" %}
    {% value type="select_instance_boxes_input" inputKey="1" %}
    - {% option form="helper_income" box="4" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Amount subject to withholding{% /instructions %}
  - {% box identifier="2" %}
    {% value type="override_number_input" inputKey="2" %}
    - {% value slot="computedValue" type="non_negative_clamp" %}
      - {% value type="difference" %}
        - {% value slot="minuend" type="box_reference" box="1" /%}
        - {% value slot="subtrahend" type="number_constant" value=200000 /%}
        {% /value %}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Withholding rate{% /instructions %}
  - {% box identifier="3" format="percentage" %}
    {% value type="override_number_input" inputKey="3" %}
    - {% value slot="computedValue" type="number_constant" value=0.009 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Additional Medicare tax withheld{% /instructions %}
  - {% box identifier="4" %}
    {% value type="override_number_input" inputKey="4" %}
    - {% value slot="computedValue" type="product" %}
      - {% value type="box_reference" box="2" /%}
      - {% value type="box_reference" box="3" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
