{% form
   category="income"
   class="f1099B"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-form-1099-b" %}
# Form 1099-B

{% subtitle %}Proceeds from Broker and Barter Exchange Transactions{% /subtitle %}

{% commentary %}
If you sell stocks during the year, the brokerage files this form with the IRS and sends a copy to you.
Generally, they report each transaction on a separate Form 1099-B.
{% /commentary %}

{% section %}
{% lines %}
- {% line index="1a" %}
  - {% instructions %}Description of property{% /instructions %}
  - {% box identifier="1a" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="1b" %}
  - {% instructions %}Date acquired{% /instructions %}
  - {% box identifier="1b" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="1c" %}
  - {% instructions %}Date sold or disposed{% /instructions %}
  - {% box identifier="1c" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="1d" %}
  - {% instructions %}Proceeds{% /instructions %}
  - {% commentary %}Usually the sale price{% /commentary %}
  - {% box identifier="1d" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1e" %}
  - {% instructions %}Cost or other basis{% /instructions %}
  - {% commentary %}Usually the purchase price{% /commentary %}
  - {% box identifier="1e" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1f" %}
  - {% instructions %}Accrued market discount{% /instructions %}
  - {% box identifier="1f" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1g" %}
  - {% instructions %}{% glossarylink term="wash-sale" %}Wash sale{% /glossarylink %} loss disallowed{% /instructions %}
  - {% box identifier="1g" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Type of gain or loss{% /instructions %}
  - {% box identifier="2" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Check if proceeds are from {% glossarylink term="collectibles" %}collectibles{% /glossarylink %} or from a {% glossarylink term="qualified-opportunity-fund" %}QOF{% /glossarylink %}{% /instructions %}
  - {% box identifier="3" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}{% glossarylink term="federal-income-tax" %}Federal income tax{% /glossarylink %} {% glossarylink term="withholding" %}withheld{% /glossarylink %}{% /instructions %}
  - {% box identifier="4" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Reported to IRS{% /instructions %}
  - {% box identifier="6" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Check if loss not allowed based on amount in box 1d{% /instructions %}
  - {% box identifier="7" %}{% value type="unused" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
