- {% line index="8" %}
  - {% instructions %}Advertising{% /instructions %}
  - {% box identifier="8" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="9" %}
  - {% instructions %}Car and truck expenses (see instructions){% /instructions %}
