{% form
   category="taxes"
   class="f1040sC"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-schedule-c-form-1040" %}
# Schedule C (Form 1040)

{% subtitle %}Profit or Loss From Business (Sole Proprietorship){% /subtitle %}

{% section %}
## Part I. Income

{% lines %}
- {% line index="1" %}
  - {% instructions %}Gross receipts or sales. See instructions for line 1 if this income was reported to you on Form W-2 and the "Statutory employee" box on that form was checked{% /instructions %}
  - {% box identifier="1" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Returns and allowances{% /instructions %}
  - {% box identifier="2" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Subtract line 2 from line 1{% /instructions %}
  - {% box identifier="3" %}
    {% value type="difference" %}
    - {% value slot="minuend" type="box_reference" box="1" /%}
    - {% value slot="subtrahend" type="box_reference" box="2" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Cost of goods sold (from line 42){% /instructions %}
  - {% box identifier="4" %}{% value type="box_reference" box="42" /%}{% /box %}
  {% /line %}
- {% line index="5" %}
  - {% instructions %}**Gross profit.** Subtract line 4 from line 3{% /instructions %}
  - {% box identifier="5" %}
    {% value type="difference" %}
    - {% value slot="minuend" type="box_reference" box="3" /%}
    - {% value slot="subtrahend" type="box_reference" box="4" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Other income, including federal and state gasoline or fuel tax credit or refund (see instructions){% /instructions %}
  - {% box identifier="6" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}**Gross income.** Add lines 5 and 6{% /instructions %}
  - {% box identifier="7" %}
    {% value type="sum" %}
    - {% value type="box_reference" box="5" /%}
    - {% value type="box_reference" box="6" /%}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}

{% section %}
## Part II. Expenses.

{% instructions %}
Enter expenses for business use of your home **only** on line 30.
{% /instructions %}

