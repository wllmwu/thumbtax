  - {% box identifier="4" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="5" %}
  - {% instructions %}{% glossarylink term="section-199A" %}Section 199A{% /glossarylink %} dividends{% /instructions %}
  - {% box identifier="5" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Investment expenses{% /instructions %}
  - {% box identifier="6" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Foreign tax paid{% /instructions %}
  - {% box identifier="7" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
