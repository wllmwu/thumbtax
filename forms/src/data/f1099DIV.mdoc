{% form
   category="income"
   class="f1099DIV"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-form-1099-div" %}
# Form 1099-DIV

{% subtitle %}Dividends and Distributions{% /subtitle %}

{% commentary %}
If you earn {% glossarylink term="dividend" %}dividends{% /glossarylink %} during the year, the bank or brokerage files this form with the IRS and sends a copy to you.
{% /commentary %}

{% section %}
{% lines %}
- {% line index="1a" %}
  - {% instructions %}Total {% glossarylink term="ordinary-dividends" %}ordinary dividends{% /glossarylink %}{% /instructions %}
  - {% box identifier="1a" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="1b" %}
  - {% instructions %}{% glossarylink term="qualified-dividends" %}Qualified dividends{% /glossarylink %}{% /instructions %}
  - {% box identifier="1b" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2a" %}
  - {% instructions %}Total {% glossarylink term="capital-gain" %}capital gain{% /glossarylink %} distributions{% /instructions %}
  - {% box identifier="2a" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2b" %}
  - {% instructions %}Unrecaptured {% glossarylink term="section-1250" %}Section 1250{% /glossarylink %} gain{% /instructions %}
  - {% box identifier="2b" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2c" %}
  - {% instructions %}{% glossarylink term="section-1202" %}Section 1202{% /glossarylink %} gain{% /instructions %}
  - {% box identifier="2c" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2d" %}
  - {% instructions %}{% glossarylink term="collectibles" %}Collectibles{% /glossarylink %} (28%) gain{% /instructions %}
  - {% box identifier="2d" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2e" %}
  - {% instructions %}{% glossarylink term="section-897" %}Section 897{% /glossarylink %} ordinary dividends{% /instructions %}
  - {% box identifier="2e" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="2f" %}
  - {% instructions %}{% glossarylink term="section-897" %}Section 897{% /glossarylink %} capital gain{% /instructions %}
  - {% box identifier="2f" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Nondividend distributions{% /instructions %}
  - {% box identifier="3" %}{% value type="number_input" /%}{% /box %}
  {% /line %}
- {% line index="4" %}
