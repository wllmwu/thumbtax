{% form
   category="income"
   class="fW2_12_codes"
   irsPageUrl="https://www.irs.gov/forms-pubs/about-form-w-2" %}
# Form W-2: codes for box 12

{% commentary %}
If your employer reported anything on {% formLink formClass="fW2" %}Form W-2{% /formLink %}, box 12a through 12d, then enter those numbers on this form.
This isn't a real tax form, it just works better with Thumbtax to model it this way.
{% /commentary %}

{% section %}
{% lines %}
- {% line index="A" %}
  - {% instructions %}Uncollected social security or RRTA tax on tips{% /instructions %}
  - {% box identifier="A" %}{% value type="number_input" inputKey="uncollected_social_security_tax_tips" /%}{% /box %}
  {% /line %}
- {% line index="B" %}
  - {% instructions %}Uncollected Medicare tax on tips{% /instructions %}
  - {% box identifier="B" %}{% value type="number_input" inputKey="uncollected_medicare_tax_tips" /%}{% /box %}
  {% /line %}
- {% line index="C" %}
  - {% instructions %}Taxable cost of group-term life insurance over $50,000{% /instructions %}
  - {% box identifier="C" %}{% value type="number_input" inputKey="group_term_life_insurance_taxable_cost" /%}{% /box %}
  {% /line %}
- {% line index="D" %}
  - {% instructions %}Elective deferrals under a section 401(k) cash or deferred arrangement (plan){% /instructions %}
  - {% box identifier="D" %}{% value type="number_input" inputKey="section_401(k)_elective_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="E" %}
  - {% instructions %}Elective deferrals under a section 403(b) salary reduction agreement{% /instructions %}
  - {% box identifier="E" %}{% value type="number_input" inputKey="section_403(b)_elective_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="F" %}
  - {% instructions %}Elective deferrals under a section 408(k)(6) salary reduction SEP{% /instructions %}
  - {% box identifier="F" %}{% value type="number_input" inputKey="section_408(k)(6)_elective_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="G" %}
  - {% instructions %}Elective deferrals and employer contributions (including nonelective deferrals) to any governmental or nongovernmental section 457(b) deferred compensation plan{% /instructions %}
  - {% box identifier="G" %}{% value type="number_input" inputKey="section_457(b)_elective_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="H" %}
  - {% instructions %}Elective deferrals under section 501(c)(18)(D) tax-exempt organization plan{% /instructions %}
  - {% box identifier="H" %}{% value type="number_input" inputKey="section_501(c)(18)(D)_elective_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="J" %}
  - {% instructions %}Nontaxable sick pay{% /instructions %}
  - {% box identifier="J" %}{% value type="number_input" inputKey="nontaxable_sick_pay" /%}{% /box %}
  {% /line %}
- {% line index="K" %}
  - {% instructions %}20% excise tax on excess {% glossaryLink term="golden-parachute" %}golden parachute{% /glossaryLink %} payments{% /instructions %}
  - {% box identifier="K" %}{% value type="number_input" inputKey="excess_golden_parachute_payments_excise_tax" /%}{% /box %}
  {% /line %}
- {% line index="L" %}
  - {% instructions %}Substantiated employee business expense reimbursements{% /instructions %}
  - {% box identifier="L" %}{% value type="number_input" inputKey="business_expense_reimbursements" /%}{% /box %}
  {% /line %}
- {% line index="M" %}
  - {% instructions %}Uncollected social security or RRTA tax on taxable cost of group-term life insurance over $50,000 (for former employees){% /instructions %}
  - {% box identifier="M" %}{% value type="number_input" inputKey="uncollected_social_security_tax_group_term_life_insurance_former_employees" /%}{% /box %}
  {% /line %}
- {% line index="N" %}
  - {% instructions %}Uncollected Medicare tax on taxable cost of group-term life insurance over $50,000 (for former employees){% /instructions %}
  - {% box identifier="N" %}{% value type="number_input" inputKey="uncollected_medicare_tax_group_term_life_insurance_former_employees" /%}{% /box %}
  {% /line %}
- {% line index="P" %}
  - {% instructions %}Excludable moving expense reimbursements paid directly to a member of the U.S. Armed Forces or intelligence community{% /instructions %}
  - {% box identifier="P" %}{% value type="number_input" inputKey="armed_forces_moving_expense_reimbursements" /%}{% /box %}
  {% /line %}
- {% line index="Q" %}
  - {% instructions %}Nontaxable combat pay{% /instructions %}
  - {% box identifier="Q" %}{% value type="number_input" inputKey="nontaxable_combat_pay" /%}{% /box %}
  {% /line %}
- {% line index="R" %}
  - {% instructions %}Employer contributions to an Archer MSA{% /instructions %}
  - {% box identifier="R" %}{% value type="number_input" inputKey="archer_msa_employer_contributions" /%}{% /box %}
  {% /line %}
- {% line index="S" %}
  - {% instructions %}Employee salary reduction contributions under a section 408(p) SIMPLE plan{% /instructions %}
  - {% box identifier="S" %}{% value type="number_input" inputKey="simple_plan_salary_reduction_contributions" /%}{% /box %}
  {% /line %}
- {% line index="T" %}
  - {% instructions %}Adoption benefits{% /instructions %}
  - {% box identifier="T" %}{% value type="number_input" inputKey="adoption_benefits" /%}{% /box %}
  {% /line %}
- {% line index="V" %}
  - {% instructions %}Income from the exercise of nonstatutory stock option(s){% /instructions %}
  - {% box identifier="V" %}{% value type="number_input" inputKey="nonstatutory_stock_option_exercise_income" /%}{% /box %}
  {% /line %}
- {% line index="W" %}
  - {% instructions %}Employer contributions to a health savings account (HSA){% /instructions %}
  - {% box identifier="W" %}{% value type="number_input" inputKey="hsa_employer_contributions" /%}{% /box %}
  {% /line %}
- {% line index="Y" %}
  - {% instructions %}Deferrals under a section 409A nonqualified deferred compensation plan{% /instructions %}
  - {% box identifier="Y" %}{% value type="number_input" inputKey="section_409A_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="Z" %}
  - {% instructions %}Income under a nonqualified deferred compensation plan that fails to satisfy section 409A{% /instructions %}
  - {% box identifier="Z" %}{% value type="number_input" inputKey="non_section_409A_plan_income" /%}{% /box %}
  {% /line %}
- {% line index="AA" %}
  - {% instructions %}Designated Roth contributions under a section 401(k) plan{% /instructions %}
  - {% box identifier="AA" %}{% value type="number_input" inputKey="section_401(k)_roth_contributions" /%}{% /box %}
  {% /line %}
- {% line index="BB" %}
  - {% instructions %}Designated Roth contributions under a section 403(b) plan{% /instructions %}
  - {% box identifier="BB" %}{% value type="number_input" inputKey="section_403(b)_roth_contributions" /%}{% /box %}
  {% /line %}
- {% line index="DD" %}
  - {% instructions %}Cost of employer-sponsored health coverage{% /instructions %}
  - {% box identifier="DD" %}{% value type="number_input" inputKey="employer_health_coverage_cost" /%}{% /box %}
  {% /line %}
- {% line index="EE" %}
  - {% instructions %}Designated Roth contributions under a governmental section 457(b) plan{% /instructions %}
  - {% box identifier="EE" %}{% value type="number_input" inputKey="section_457(b)_roth_contributions" /%}{% /box %}
  {% /line %}
- {% line index="FF" %}
  - {% instructions %}Permitted benefits under a qualified small employer health reimbursement arrangement{% /instructions %}
  - {% box identifier="FF" %}{% value type="number_input" inputKey="small_employer_health_reimbursement_arrangement_benefits" /%}{% /box %}
  {% /line %}
- {% line index="GG" %}
  - {% instructions %}Income from qualified equity grants under section 83(i){% /instructions %}
  - {% box identifier="GG" %}{% value type="number_input" inputKey="section_83(i)_equity_grant_income" /%}{% /box %}
  {% /line %}
- {% line index="HH" %}
  - {% instructions %}Aggregate deferrals under section 83(i) elections as of the close of the calendar year{% /instructions %}
  - {% box identifier="HH" %}{% value type="number_input" inputKey="section_83(i)_aggregate_deferrals" /%}{% /box %}
  {% /line %}
- {% line index="II" %}
  - {% instructions %}Medicaid waiver payments excluded from gross income under Notice 2014-7{% /instructions %}
  - {% box identifier="II" %}{% value type="number_input" inputKey="excluded_medicaid_waiver_payments" /%}{% /box %}
  {% /line %}
- {% line index="TA" %}
  - {% instructions %}Employer contributions under a section 128 Trump account contribution program paid to a Trump account of an employee or a dependent of an employee{% /instructions %}
  - {% box identifier="TA" %}{% value type="number_input" inputKey="section_128_trump_account_employer_contributions" /%}{% /box %}
  {% /line %}
- {% line index="TP" %}
  - {% instructions %}Total amount of cash tips reported to the employer{% /instructions %}
  - {% box identifier="TP" %}{% value type="number_input" inputKey="total_cash_tips_reported" /%}{% /box %}
  {% /line %}
- {% line index="TT" %}
  - {% instructions %}Total amount of qualified overtime compensation{% /instructions %}
  - {% box identifier="TT" %}{% value type="number_input" inputKey="total_qualified_overtime_compensation" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
