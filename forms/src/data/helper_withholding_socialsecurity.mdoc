{% form
   category="income"
   class="helper_withholding_socialsecurity"
   irsPageUrl="" %}
# My Social Security withholding

{% subtitle %}
Helper form: Social Security tax withholding
{% /subtitle %}

{% instructions %}
Thumbtax uses this "helper" form to model a part of your income tax withholding.
This isn't a real tax form.
You can modify these values directly or use the wizard again to replace them.
{% /instructions %}

{% section %}
{% lines %}
- {% line index="1" %}
  - {% instructions %}Gross amount{% /instructions %}
  - {% box identifier="1" %}
    {% value type="select_instance_boxes_input" %}
    - {% option form="helper_income" box="4" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Amount subject to withholding{% /instructions %}
  - {% box identifier="2" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="box_reference" box="1" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Withholding rate{% /instructions %}
  - {% box identifier="3" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="number_constant" value=0.062 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Social Security tax withheld{% /instructions %}
  - {% box identifier="4" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="product" %}
      - {% value type="minimum" %}
        - {% value type="box_reference" box="2" /%}
        - {% value type="number_constant" value=184500 /%}
        {% /value %}
      - {% value type="box_reference" box="3" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
