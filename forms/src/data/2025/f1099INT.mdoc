{% form
   category="income"
   class="f1099INT"
   govAboutUrl="https://www.irs.gov/forms-pubs/about-form-1099-int" %}
# Form 1099-INT

{% subtitle %}Interest Income{% /subtitle %}

{% commentary %}
If you earn interest during the year, the payer files this form with the IRS and sends a copy to you.
{% /commentary %}

{% section %}
{% lines %}
- {% line index="1" %}
  - {% instructions %}Interest income{% /instructions %}
  - {% box identifier="1" %}{% value type="number_input" inputKey="interest_income" /%}{% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Early withdrawal penalty{% /instructions %}
  - {% box identifier="2" %}{% value type="number_input" inputKey="early_withdrawal_penalty" /%}{% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Interest on U.S. Savings Bonds and Treasury obligations{% /instructions %}
  - {% box identifier="3" %}{% value type="number_input" inputKey="us_savings_bonds_treasury_interest" /%}{% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}{% glossaryLink term="federal-income-tax" %}Federal income tax{% /glossaryLink %} {% glossaryLink term="withholding" %}withheld{% /glossaryLink %}{% /instructions %}
  - {% commentary %}{% glossaryLink term="backup-withholding" %}Backup withholding{% /glossaryLink %}{% /commentary %}
  - {% box identifier="4" %}{% value type="number_input" inputKey="federal_income_tax_withheld" /%}{% /box %}
  {% /line %}
- {% line index="5" %}
  - {% instructions %}Investment expenses{% /instructions %}
  - {% box identifier="5" %}{% value type="number_input" inputKey="investment_expenses" /%}{% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Foreign tax paid{% /instructions %}
  - {% box identifier="6" %}{% value type="number_input" inputKey="foreign_tax_paid" /%}{% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Foreign country or U.S. territory{% /instructions %}
  - {% box identifier="7" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="8" %}
  - {% instructions %}Tax-exempt interest{% /instructions %}
  - {% box identifier="8" %}{% value type="number_input" inputKey="tax_exempt_interest" /%}{% /box %}
  {% /line %}
- {% line index="9" %}
  - {% instructions %}{% glossaryLink term="specified-private-activity-bond" %}Specified private activity bond{% /glossaryLink %} interest{% /instructions %}
  - {% box identifier="9" %}{% value type="number_input" inputKey="specified_private_activity_bond_interest" /%}{% /box %}
  {% /line %}
- {% line index="10" %}
  - {% instructions %}Market discount{% /instructions %}
  - {% box identifier="10" %}{% value type="number_input" inputKey="market_discount" /%}{% /box %}
  {% /line %}
- {% line index="11" %}
  - {% instructions %}Bond premium{% /instructions %}
  - {% box identifier="11" %}{% value type="number_input" inputKey="bond_premium" /%}{% /box %}
  {% /line %}
- {% line index="12" %}
  - {% instructions %}Bond premium on Treasury obligations{% /instructions %}
  - {% box identifier="12" %}{% value type="number_input" inputKey="treasury_obligations_bond_premium" /%}{% /box %}
  {% /line %}
- {% line index="13" %}
  - {% instructions %}Bond premium on tax-exempt bond{% /instructions %}
  - {% box identifier="13" %}{% value type="number_input" inputKey="tax_exempt_bond_premium" /%}{% /box %}
  {% /line %}
- {% line index="14" %}
  - {% instructions %}Tax-exempt and tax credit bond CUSIP number{% /instructions %}
  - {% box identifier="14" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="15" %}
  - {% instructions %}State{% /instructions %}
  - {% box identifier="15" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="16" %}
  - {% instructions %}State identification number{% /instructions %}
  - {% box identifier="16" %}{% value type="unused" /%}{% /box %}
  {% /line %}
- {% line index="17" %}
  - {% instructions %}State tax withheld{% /instructions %}
  - {% box identifier="17" %}{% value type="number_input" inputKey="state_tax_withheld" /%}{% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
