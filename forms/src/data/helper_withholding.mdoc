{% form category="income" class="helper_withholding" irsPageUrl="" %}
# My federal withholding

{% subtitle %}
Helper form: My federal withholding
{% /subtitle %}

{% instructions %}
Thumbtax uses this "helper" form to model a part of your federal income tax withholding.
This isn't a real tax form.
You can modify these values directly or use the wizard again to replace them.
{% /instructions %}

{% section %}
{% lines %}
- {% line index="1" %}
  - {% instructions %}Gross amount{% /instructions %}
  - {% box identifier="1" %}
    {% value type="select_instance_boxes_input" %}
    - {% option form="helper_income" box="9" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="2" %}
  - {% instructions %}Federal income type{% /instructions %}
  - {% box identifier="2" %}
    {% value type="select_value_input" %}
    - {% value key="regular" label="Regular income" type="quotient" %}
      - {% value slot="dividend" type="_partial_passthrough" %}
        - {% partial file="taxComputation" variables={box: "1"} /%}
        {% /value %}
      - {% value slot="divisor" type="box_reference" box="1" /%}
      {% /value %}
    - {% value
         key="supplemental"
         label="Supplemental income"
         type="number_constant"
         value=0.22 /%}
    - {% value key="not_applicable" label="N/A" type="number_constant" value=0 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="3" %}
  - {% instructions %}Federal income tax withholding rate{% /instructions %}
  - {% box identifier="3" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="box_reference" box="2" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="4" %}
  - {% instructions %}Additional federal withholding{% /instructions %}
  - {% box identifier="4" %}
    {% value type="number_input" /%}
    {% /box %}
  {% /line %}
- {% line index="5" %}
  - {% instructions %}Federal income tax withheld{% /instructions %}
  - {% box identifier="5" %}
    {% value type="sum" %}
    - {% value type="product" %}
      - {% value type="box_reference" box="1" /%}
      - {% value type="box_reference" box="3" /%}
      {% /value %}
    - {% value type="box_reference" box="4" /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="6" %}
  - {% instructions %}Social Security tax withholding rate{% /instructions %}
  - {% box identifier="6" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="number_constant" value=0.062 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="7" %}
  - {% instructions %}Social Security tax withheld{% /instructions %}
  - {% box identifier="7" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="product" %}
      - {% value type="minimum" %}
        - {% value type="box_reference" box="1" /%}
        - {% value type="number_constant" value=184500 /%}
        {% /value %}
      - {% value type="box_reference" box="6" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="8" %}
  - {% instructions %}Medicare tax withholding rate{% /instructions %}
  - {% box identifier="8" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="number_constant" value=0.0145 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="9" %}
  - {% instructions %}Medicare tax withheld{% /instructions %}
  - {% box identifier="9" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="product" %}
      - {% value type="box_reference" box="1" /%}
      - {% value type="box_reference" box="8" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="10" %}
  - {% instructions %}Additional Medicare tax withholding rate{% /instructions %}
  - {% box identifier="10" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="number_constant" value=0.009 /%}
    {% /value %}
    {% /box %}
  {% /line %}
- {% line index="11" %}
  - {% instructions %}Additional Medicare tax withheld{% /instructions %}
  - {% box identifier="11" format="percentage" %}
    {% value type="override_number_input" %}
    - {% value slot="computedValue" type="product" %}
      - {% value type="non_negative_clamp" %}
        - {% value type="difference" %}
          - {% value slot="minuend" type="box_reference" box="1" /%}
          - {% value slot="subtrahend" type="number_constant" value=200000 /%}
          {% /value %}
        {% /value %}
      - {% value type="box_reference" box="10" /%}
      {% /value %}
    {% /value %}
    {% /box %}
  {% /line %}
{% /lines %}
{% /section %}
{% /form %}
